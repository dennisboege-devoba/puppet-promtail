{
  "name": "grafana-promtail",
  "version": "2.1.0",
  "author": "grafana",
  "summary": "Deploy and configure Grafana's Promtail",
  "license": "Apache-2.0",
  "source": "https://github.com/grafana/puppet-promtail.git",
  "project_page": "https://github.com/grafana/puppet-promtail",
  "issues_url": "https://github.com/grafana/puppet-promtail/issues",
  "dependencies": [
    {
      "name": "puppet/systemd",
      "version_requirement": ">= 7.0.0 < 12.0.0"
    },
    {
      "name": "puppet/archive",
      "version_requirement": ">= 8.0.0 < 10.0.0"
    },
    {
      "name": "puppetlabs/concat",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    },
    {
      "name": "puppetlabs/stdlib",
      "version_requirement": ">= 9.0.0 < 11.0.0"
    }
  ],
  "operatingsystem_support": [
    {
      "operatingsystem": "Debian",
      "operatingsystemrelease": [
        "12",
        "13"
      ]
    },
    {
      "operatingsystem": "Ubuntu",
      "operatingsystemrelease": [
        "22.04",
        "24.04"
      ]
    },
    {
      "operatingsystem": "RedHat",
      "operatingsystemrelease": [
        "8",
        "9"
      ]
    },
    {
      "operatingsystem": "SLES",
      "operatingsystemrelease": [
        "15"
      ]
    }
  ],
  "requirements": [
    {
      "name": "openvox",
      "version_requirement": ">= 8.0.0 < 9.0.0"
    }
  ]
}
